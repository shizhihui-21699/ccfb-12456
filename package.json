{
  "name": "workflow-audit-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GitHub Actions workflow security audit console",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "start": "node scripts/serve.ts",
    "test": "node scripts/test.ts",
    "typecheck": "tsc --noEmit",
    "audit": "node src/cli.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "preact": "10.29.8",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "preact-render-to-string": "6.8.3",
    "typescript": "5.9.3"
  }
}
